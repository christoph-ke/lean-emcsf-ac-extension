namespace EmcsfAcExtension

open MeasureTheory Set Filter Topology Complex
open scoped ENNReal

/-- The positive-exponent integrand `(-ν)μ/((1-μ)r)` (L148–156). -/
noncomputable def positiveExpIntegrand (S : Fields) (u v : ℝ) : ℝ :=
  -S.nu u v * S.mu u v / ((1 - S.mu u v) * S.r u v)

end EmcsfAcExtension
