@[expose] public section

namespace EmcsfAcExtension

open MeasureTheory Set Filter Topology Complex
open scoped ENNReal

/-- The charged local characteristic AC/BV class on a domain `D` (L95–124, L670–683, L705–714),
in the gauge `A_v = 0`, with coupling `e`. -/
structure IsSolution (e : ℝ) (S : Fields) (D : Set (ℝ × ℝ)) : Prop where
  /-- the domain lies in `{u ≤ v}`; its axis points are those with `u = v` -/
  subset : D ⊆ {p | p.1 ≤ p.2}
  /-- radius is positive off the axis -/
  r_pos : ∀ p ∈ D, p.1 < p.2 → 0 < S.r p.1 p.2
  /-- `λ > 0` (L74) -/
  lam_pos : ∀ p ∈ D, 0 < S.lam p.1 p.2
  /-- `ν < 0` (L74) -/
  nu_neg : ∀ p ∈ D, S.nu p.1 p.2 < 0
  /-- `1 - μ > 0` (L76) -/
  one_sub_mu_pos : ∀ p ∈ D, 0 < 1 - S.mu p.1 p.2
  /-- the undifferentiated fields, expansions and normalized fields are continuous -/
  cont_r : ContinuousOn (Function.uncurry S.r) D
  cont_lam : ContinuousOn (Function.uncurry S.lam) D
  cont_nu : ContinuousOn (Function.uncurry S.nu) D
  cont_m : ContinuousOn (Function.uncurry S.m) D
  cont_Q : ContinuousOn (Function.uncurry S.Q) D
  cont_phi : ContinuousOn (Function.uncurry S.phi) D
  cont_A : ContinuousOn (Function.uncurry S.A) D
  cont_theta : ContinuousOn (Function.uncurry S.theta) D
  cont_xi : ContinuousOn (Function.uncurry S.xi) D
  /-- the reduced equations in integral form along off-axis outgoing segments -/
  eq_out : ∀ u v₁ v₂, u < v₁ → v₁ ≤ v₂ → outSeg u v₁ v₂ ⊆ D →
    IntegralForm (S.r u) (S.lam u) v₁ v₂ ∧ IntegralForm (S.nu u) (S.rUV u) v₁ v₂ ∧
    IntegralForm (S.m u) (S.mV u) v₁ v₂ ∧ IntegralForm (S.Q u) (S.QV e u) v₁ v₂ ∧
    IntegralForm (S.A u) (S.AV u) v₁ v₂ ∧ IntegralForm (S.phi u) (S.phiV u) v₁ v₂ ∧
    IntegralForm (S.xi u) (S.xiV e u) v₁ v₂
  /-- the reduced equations in integral form along off-axis incoming segments -/
  eq_in : ∀ u₁ u₂ v, u₁ ≤ u₂ → u₂ < v → inSeg u₁ u₂ v ⊆ D →
    IntegralForm (fun u => S.r u v) (fun u => S.nu u v) u₁ u₂ ∧
    IntegralForm (fun u => S.lam u v) (fun u => S.rUV u v) u₁ u₂ ∧
    IntegralForm (fun u => S.m u v) (fun u => S.mU u v) u₁ u₂ ∧
    IntegralForm (fun u => S.Q u v) (fun u => S.QU e u v) u₁ u₂ ∧
    IntegralForm (fun u => S.phi u v) (fun u => S.phiU e u v) u₁ u₂ ∧
    IntegralForm (fun u => S.theta u v) (fun u => S.thetaU e u v) u₁ u₂
  /-- `r, m, Q, φ` and `α/λ` are AC on compact outgoing segments of `D` -/
  ac_out : ∀ u v₁ v₂, v₁ ≤ v₂ → outSeg u v₁ v₂ ⊆ D →
    AbsolutelyContinuousOnInterval (S.r u) v₁ v₂ ∧ AbsolutelyContinuousOnInterval (S.m u) v₁ v₂ ∧
    AbsolutelyContinuousOnInterval (S.Q u) v₁ v₂ ∧
    AbsolutelyContinuousOnInterval (S.phi u) v₁ v₂ ∧ AbsolutelyContinuousOnInterval (S.a u) v₁ v₂
  /-- `r, m, Q, φ` are AC on compact incoming segments of `D` -/
  ac_in : ∀ u₁ u₂ v, u₁ ≤ u₂ → inSeg u₁ u₂ v ⊆ D →
    AbsolutelyContinuousOnInterval (fun u => S.r u v) u₁ u₂ ∧
    AbsolutelyContinuousOnInterval (fun u => S.m u v) u₁ u₂ ∧
    AbsolutelyContinuousOnInterval (fun u => S.Q u v) u₁ u₂ ∧
    AbsolutelyContinuousOnInterval (fun u => S.phi u v) u₁ u₂
  /-- locally bounded characteristic variation of `λ, ν, α/λ, β/ν` in both null directions -/
  bv_loc : ∀ K ⊆ D, IsCompact K → ∃ B : ℝ≥0∞, B < ⊤ ∧
    (∀ u v₁ v₂, outSeg u v₁ v₂ ⊆ K →
      eVariationOn (S.lam u) (Icc v₁ v₂) ≤ B ∧ eVariationOn (S.nu u) (Icc v₁ v₂) ≤ B ∧
      eVariationOn (S.a u) (Icc v₁ v₂) ≤ B ∧ eVariationOn (S.b u) (Icc v₁ v₂) ≤ B) ∧
    (∀ u₁ u₂ v, inSeg u₁ u₂ v ⊆ K →
      eVariationOn (fun u => S.lam u v) (Icc u₁ u₂) ≤ B ∧
      eVariationOn (fun u => S.nu u v) (Icc u₁ u₂) ≤ B ∧
      eVariationOn (fun u => S.a u v) (Icc u₁ u₂) ≤ B ∧
      eVariationOn (fun u => S.b u v) (Icc u₁ u₂) ≤ B)
  /-- the scalar's characteristic variations vanish uniformly on shrinking triangles about each
  existing axis point -/
  axis_small_var : ∀ t, (t, t) ∈ D → ∀ η : ℝ, 0 < η → ∃ δ : ℝ, 0 < δ ∧
    (∀ u v₁ v₂, outSeg u v₁ v₂ ⊆ D ∩ triangle (t - δ) (t + δ) →
      eVariationOn (S.phi u) (Icc v₁ v₂) ≤ ENNReal.ofReal η) ∧
    (∀ u₁ u₂ v, inSeg u₁ u₂ v ⊆ D ∩ triangle (t - δ) (t + δ) →
      eVariationOn (fun u => S.phi u v) (Icc u₁ u₂) ≤ ENNReal.ofReal η)
  /-- regular-axis conditions `r = m = Q = 0`, `λ + ν = 0`, `α/λ = β/ν = φ|_Γ` (L115–120) -/
  axis : ∀ t, (t, t) ∈ D → S.r t t = 0 ∧ S.m t t = 0 ∧ S.Q t t = 0 ∧
    S.lam t t + S.nu t t = 0 ∧ S.a t t = S.phi t t ∧ S.b t t = S.phi t t
  /-- `μ → 0` at each existing axis point -/
  axis_mu : ∀ t, (t, t) ∈ D →
    Tendsto (Function.uncurry S.mu) (𝓝[D ∩ {p | p.1 < p.2}] (t, t)) (𝓝 0)

end EmcsfAcExtension
