/-- Equality of two configurations at every point of `D`. -/
def EqOn (S' : Fields) (D : Set (ℝ × ℝ)) : Prop :=
  ∀ p ∈ D, S.r p.1 p.2 = S'.r p.1 p.2 ∧ S.lam p.1 p.2 = S'.lam p.1 p.2 ∧
    S.nu p.1 p.2 = S'.nu p.1 p.2 ∧ S.m p.1 p.2 = S'.m p.1 p.2 ∧ S.Q p.1 p.2 = S'.Q p.1 p.2 ∧
    S.phi p.1 p.2 = S'.phi p.1 p.2 ∧ S.A p.1 p.2 = S'.A p.1 p.2 ∧
    S.theta p.1 p.2 = S'.theta p.1 p.2 ∧ S.xi p.1 p.2 = S'.xi p.1 p.2

end Fields

