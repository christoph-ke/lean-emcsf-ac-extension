namespace Fields

variable (S : Fields) (e : ℝ)

/-- `r_{uv} = (νλ/r)(μ - Q²/r²)/(1-μ)`; the right side of `∂_u λ` and of `∂_v ν`. -/
noncomputable def rUV (u v : ℝ) : ℝ :=
  S.nu u v * S.lam u v / S.r u v * ((S.mu u v - S.Q u v ^ 2 / S.r u v ^ 2) / (1 - S.mu u v))

