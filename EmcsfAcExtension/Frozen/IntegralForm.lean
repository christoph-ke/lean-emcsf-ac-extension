namespace EmcsfAcExtension

open MeasureTheory Set Filter Topology Complex
open scoped ENNReal

/-- `f' = g` on `[s, t]` in integral form. -/
def IntegralForm {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f g : ℝ → E) (s t : ℝ) : Prop :=
  IntervalIntegrable g volume s t ∧ f t - f s = ∫ x in s..t, g x

