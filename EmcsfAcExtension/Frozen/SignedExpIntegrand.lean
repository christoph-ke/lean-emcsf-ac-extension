/-- The signed terminal-exponent integrand `(-ν)(μ - Q²/r²)/((1-μ)r)` (L136–138). -/
noncomputable def signedExpIntegrand (S : Fields) (u v : ℝ) : ℝ :=
  -S.nu u v * (S.mu u v - S.Q u v ^ 2 / S.r u v ^ 2) / ((1 - S.mu u v) * S.r u v)

