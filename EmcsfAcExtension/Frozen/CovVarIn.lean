/-- Covariant incoming variation `∫ |D_u f| du` on `[u₁, u₂]` at fixed `v`, as the ordinary
variation of the unitary parallel-transported representative `exp(ie∫_{u₁}^u A_u) f` (L685–688). -/
noncomputable def covVarIn (e : ℝ) (A : ℝ → ℝ → ℝ) (f : ℝ → ℝ → ℂ) (u₁ u₂ v : ℝ) : ℝ≥0∞ :=
  eVariationOn (fun u => Complex.exp (I * e * ∫ s in u₁..u, A s v) * f u v) (Icc u₁ u₂)

end EmcsfAcExtension
