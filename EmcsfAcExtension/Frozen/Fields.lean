/-- A double-null configuration of the reduced, spherically symmetric, massless
Einstein–Maxwell–charged-scalar-field system in the gauge `A_v = 0`
(`charged_SF.tex` L72–90, L655–664, L3874–3905). Coordinates are `(u, v)`; each field is a
function of `u` and then `v`. -/
structure Fields where
  /-- area radius `r` -/
  r : ℝ → ℝ → ℝ
  /-- `λ = ∂_v r` -/
  lam : ℝ → ℝ → ℝ
  /-- `ν = ∂_u r` -/
  nu : ℝ → ℝ → ℝ
  /-- Hawking mass `m` -/
  m : ℝ → ℝ → ℝ
  /-- electric charge `Q` -/
  Q : ℝ → ℝ → ℝ
  /-- complex scalar field `φ` (`√(4π)` times Kommemi's scalar) -/
  phi : ℝ → ℝ → ℂ
  /-- the component `A_u` of the Maxwell potential; `A_v = 0` -/
  A : ℝ → ℝ → ℝ
  /-- `θ = r D_v φ = r ∂_v φ` -/
  theta : ℝ → ℝ → ℂ
  /-- `ξ = r D_u φ` -/
  xi : ℝ → ℝ → ℂ

end EmcsfAcExtension
